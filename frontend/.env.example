NEXT_PUBLIC_API_URL=http://localhost:8000

# Login (Supabase Auth). Public values: the same as SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY in the
# repo-root .env. Never put a secret key (sb_secret_...) here. Without them nobody can log in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
