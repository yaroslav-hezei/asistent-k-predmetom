# Copy to `.env` in the repo root and fill in. Never commit `.env`.
# The backend reads it with `uvicorn ... --env-file ../.env`; scripts load it themselves.

# Postgres of the shared Supabase project: Dashboard → Connect → Session pooler.
# Replace [YOUR-PASSWORD]; percent-encode reserved characters (& # ? / @ : % space) in the password.
# Leave it unset to run the backend without a database (the catalogue still works).
DATABASE_URL=

# Supabase project URL (https://<project-ref>.supabase.co): the backend verifies login tokens with
# the project's public keys. Leave it unset and nobody can log in (/me answers 503).
SUPABASE_URL=

# Public key (sb_publishable_...): what the browser uses to log in; safe to show.
SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...): ONLY for scripts/create_test_users.py. Never in the deployed backend,
# never in the frontend, never in chat or a commit.
SUPABASE_SECRET_KEY=

# Optional: CORS origins of the frontend (default http://localhost:3000).
# FRONTEND_ORIGINS=http://localhost:3000

# Tests only: a throwaway LOCAL database (npx supabase@3.2.0 db start), never the cloud one.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
