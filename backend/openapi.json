{
  "openapi": "3.1.0",
  "info": {
    "title": "Asistent k predmetom API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness check",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/programs": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List study programs",
        "operationId": "list_programs_programs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Program"
                  },
                  "type": "array",
                  "title": "Response List Programs Programs Get"
                }
              }
            }
          }
        }
      }
    },
    "/programs/{program_id}/courses": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Courses in a program's study plan",
        "operationId": "list_program_courses_programs__program_id__courses_get",
        "parameters": [
          {
            "name": "program_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Program Id"
            }
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 4,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Year of study.",
              "title": "Year"
            },
            "description": "Year of study."
          },
          {
            "name": "semester",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "ZS",
                    "LS"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ZS or LS.",
              "title": "Semester"
            },
            "description": "ZS or LS."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProgramCourse"
                  },
                  "title": "Response List Program Courses Programs  Program Id  Courses Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/courses": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Search courses by name or code",
        "operationId": "search_courses_courses_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Words to find in the name or code; case and diacritics are ignored.",
              "title": "Q"
            },
            "description": "Words to find in the name or code; case and diacritics are ignored."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CourseSummary"
                  },
                  "title": "Response Search Courses Courses Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/courses/{course_id}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "One course",
        "operationId": "get_course_courses__course_id__get",
        "parameters": [
          {
            "name": "course_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Course Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "The logged-in user",
        "operationId": "read_me_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token."
          },
          "403": {
            "description": "The account has no profile."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "patch": {
        "tags": [
          "me"
        ],
        "summary": "Set program, year and semester of the logged-in user",
        "operationId": "update_me_me_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Study"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token."
          },
          "403": {
            "description": "The account has no profile."
          },
          "422": {
            "description": "Unknown program or year."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/ask": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Ask a question about a course",
        "description": "Stores the question and the answer in a chat: a new one when `chat_id` is null. Until the RAG step the answer is a placeholder: one real section of the course's MAIS sheet; a question with the word 'neviem' gets the 'Neviem' answer.",
        "operationId": "ask_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token."
          },
          "403": {
            "description": "The account has no profile."
          },
          "404": {
            "description": "Unknown course, or the chat does not exist / is not yours."
          },
          "422": {
            "description": "Invalid question, or the chat belongs to another course."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/chats": {
      "get": {
        "tags": [
          "chat"
        ],
        "summary": "The user's chats for 'História', newest first (at most 50)",
        "operationId": "read_chats_chats_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ChatSummary"
                  },
                  "type": "array",
                  "title": "Response Read Chats Chats Get"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token."
          },
          "403": {
            "description": "The account has no profile."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/chats/{chat_id}": {
      "get": {
        "tags": [
          "chat"
        ],
        "summary": "One chat with its messages",
        "operationId": "read_chat_chats__chat_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "chat_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Chat Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chat"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token."
          },
          "403": {
            "description": "The account has no profile."
          },
          "404": {
            "description": "The chat does not exist or is not yours."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "course_id": {
            "type": "string",
            "minLength": 1,
            "title": "Course Id",
            "description": "MAIS id of the course, as in /courses.",
            "examples": [
              "65954478"
            ]
          },
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Question",
            "examples": [
              "Ako sa hodnotí tento predmet?"
            ]
          },
          "chat_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chat Id",
            "description": "Continue this chat; null starts a new chat for the course."
          }
        },
        "type": "object",
        "required": [
          "course_id",
          "question"
        ],
        "title": "AskRequest"
      },
      "AskResponse": {
        "properties": {
          "chat_id": {
            "type": "string",
            "format": "uuid",
            "title": "Chat Id",
            "description": "The chat the question went to (new or continued)."
          },
          "question": {
            "$ref": "#/components/schemas/ChatMessage"
          },
          "answer": {
            "$ref": "#/components/schemas/ChatMessage"
          }
        },
        "type": "object",
        "required": [
          "chat_id",
          "question",
          "answer"
        ],
        "title": "AskResponse"
      },
      "Author": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "mais",
              "student",
              "vyucujuci"
            ],
            "title": "Kind"
          },
          "nickname": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nickname",
            "description": "Null for the MAIS sheet.",
            "examples": [
              "tomas_r"
            ]
          }
        },
        "type": "object",
        "required": [
          "kind",
          "nickname"
        ],
        "title": "Author",
        "description": "Who wrote the source: the official MAIS sheet, a student or a teacher."
      },
      "Chat": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "course": {
            "$ref": "#/components/schemas/CourseSummary"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "The first question, cut to 200 characters."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At",
            "description": "Time of the last question."
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "title": "Messages",
            "description": "Oldest first."
          }
        },
        "type": "object",
        "required": [
          "id",
          "course",
          "title",
          "updated_at",
          "messages"
        ],
        "title": "Chat"
      },
      "ChatMessage": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text",
            "description": "User: the question. Assistant: the answer with [n] citations; null when found is false (the frontend shows its own 'Neviem' text)."
          },
          "found": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Found",
            "description": "Assistant only: false = 'Neviem', offer 'Zverejniť otázku'. Null for user."
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources",
            "description": "Assistant only; empty for user and for 'Neviem'."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "text",
          "found",
          "sources",
          "created_at"
        ],
        "title": "ChatMessage",
        "description": "A question of the user or an answer of the assistant."
      },
      "ChatSummary": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "course": {
            "$ref": "#/components/schemas/CourseSummary"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "The first question, cut to 200 characters."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At",
            "description": "Time of the last question."
          }
        },
        "type": "object",
        "required": [
          "id",
          "course",
          "title",
          "updated_at"
        ],
        "title": "ChatSummary",
        "description": "A chat in \"História\": one chat = one course."
      },
      "CourseSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "MAIS predmetId of the course sheet.",
            "examples": [
              "65954478"
            ]
          },
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Course code.",
            "examples": [
              "26000629"
            ]
          },
          "name": {
            "type": "string",
            "title": "Name",
            "examples": [
              "Základy algoritmizácie a programovania"
            ]
          },
          "credits": {
            "type": "integer",
            "title": "Credits",
            "description": "Credits from the information sheet.",
            "examples": [
              5
            ]
          },
          "semesters": {
            "items": {
              "type": "string",
              "enum": [
                "ZS",
                "LS"
              ]
            },
            "type": "array",
            "title": "Semesters",
            "description": "Recommended semester(s) from the information sheet.",
            "examples": [
              [
                "ZS"
              ]
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "credits",
          "semesters"
        ],
        "title": "CourseSummary",
        "description": "A course as described by its MAIS information sheet."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "Me": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "User id (Supabase Auth)."
          },
          "nickname": {
            "type": "string",
            "title": "Nickname",
            "description": "Shown as the author of questions and answers."
          },
          "role": {
            "type": "string",
            "enum": [
              "student",
              "vyucujuci"
            ],
            "title": "Role"
          },
          "study": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Study"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null when the user has not chosen it yet."
          }
        },
        "type": "object",
        "required": [
          "id",
          "nickname",
          "role",
          "study"
        ],
        "title": "Me",
        "description": "The logged-in user's profile."
      },
      "Program": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "MAIS program id.",
            "examples": [
              "65669424"
            ]
          },
          "code": {
            "type": "string",
            "title": "Code",
            "examples": [
              "HI_Bc_D_sk"
            ]
          },
          "name": {
            "type": "string",
            "title": "Name",
            "examples": [
              "Hospodárska informatika"
            ]
          },
          "degree": {
            "type": "string",
            "enum": [
              "bc",
              "bc_po",
              "ing"
            ],
            "title": "Degree",
            "description": "bc = 1st degree, bc_po = 1st degree professionally oriented, ing = 2nd degree."
          },
          "language": {
            "type": "string",
            "enum": [
              "sk",
              "en"
            ],
            "title": "Language",
            "description": "Teaching language of the program."
          },
          "method": {
            "type": "string",
            "enum": [
              "prezencna",
              "kombinovana"
            ],
            "title": "Method",
            "description": "Study method."
          },
          "years": {
            "type": "integer",
            "title": "Years",
            "description": "Standard length of study in years.",
            "examples": [
              3
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "degree",
          "language",
          "method",
          "years"
        ],
        "title": "Program",
        "description": "A study program (FEI, denná forma, one academic year)."
      },
      "ProgramCourse": {
        "properties": {
          "course": {
            "$ref": "#/components/schemas/CourseSummary"
          },
          "year": {
            "type": "integer",
            "title": "Year",
            "description": "Year of study.",
            "examples": [
              3
            ]
          },
          "semester": {
            "type": "string",
            "enum": [
              "ZS",
              "LS"
            ],
            "title": "Semester",
            "description": "Semester of the plan; for state-exam courses taken from the sheet."
          },
          "type": {
            "type": "string",
            "enum": [
              "P",
              "PV",
              "V"
            ],
            "title": "Type",
            "description": "P = povinný, PV = povinne voliteľný, V = výberový."
          },
          "state_exam": {
            "type": "boolean",
            "title": "State Exam",
            "description": "True for courses from the state-exam table."
          }
        },
        "type": "object",
        "required": [
          "course",
          "year",
          "semester",
          "type",
          "state_exam"
        ],
        "title": "ProgramCourse",
        "description": "One course in a program's study plan, placed in a year and semester."
      },
      "QuestionRef": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "title": "Text",
            "examples": [
              "Môžem robiť semestrálny projekt sám, alebo len v tíme?"
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "title": "QuestionRef",
        "description": "The community question a community answer belongs to."
      },
      "Source": {
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1.0,
            "title": "N",
            "description": "Number cited in the answer text as [n].",
            "examples": [
              1
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "sheet",
              "answer",
              "course_note"
            ],
            "title": "Type",
            "description": "sheet = MAIS information sheet; answer = an answer from Otázky komunity; course_note = the teacher's Aktuálna informácia k predmetu."
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section",
            "description": "Sheet section label; null for other types.",
            "examples": [
              "Priebežné hodnotenie (PH)"
            ]
          },
          "quote": {
            "type": "string",
            "title": "Quote",
            "description": "Exact stored text the answer relies on."
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url",
            "description": "Sheet: link to the sheet in MAIS. Null for other types.",
            "examples": [
              "https://maisportal.tuke.sk/portal/tlacPredmetuOSP.mais?predmetId=65954478"
            ]
          },
          "question": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QuestionRef"
              },
              {
                "type": "null"
              }
            ],
            "description": "Type answer: the community question it answers. Null for other types."
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "title": "Date",
            "description": "Sheet: when the sheet was read from MAIS (MAIS has no reliable change date), shown as 'stav k …'. Answer and course note: when it was written."
          },
          "author": {
            "$ref": "#/components/schemas/Author"
          },
          "verified": {
            "type": "boolean",
            "title": "Verified",
            "description": "True for the sheet and the teacher's note; for a community answer: verified by a teacher (Overené) or not (Neoverené)."
          },
          "outdated": {
            "type": "boolean",
            "title": "Outdated",
            "description": "Sheet: show the outdated-sheet warning. Always false until its rule is set."
          }
        },
        "type": "object",
        "required": [
          "n",
          "type",
          "section",
          "quote",
          "url",
          "question",
          "date",
          "author",
          "verified",
          "outdated"
        ],
        "title": "Source",
        "description": "One source under an answer. The answer text cites it as [n]."
      },
      "Study": {
        "properties": {
          "program_id": {
            "type": "string",
            "title": "Program Id",
            "description": "MAIS program id.",
            "examples": [
              "65669424"
            ]
          },
          "year": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "Year",
            "description": "Year of study.",
            "examples": [
              3
            ]
          },
          "semester": {
            "type": "string",
            "enum": [
              "ZS",
              "LS"
            ],
            "title": "Semester"
          }
        },
        "type": "object",
        "required": [
          "program_id",
          "year",
          "semester"
        ],
        "title": "Study",
        "description": "Program, year and semester of a student: what \"Moje predmety\" shows."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Supabase access token of the logged-in user.",
        "scheme": "bearer"
      }
    }
  }
